  </div>
</div>

<script>
const $ = (id) => document.getElementById(id);

$("year").textContent = new Date().getFullYear();

const menu = $("navLinks");
const menuButton = $("menuToggle");

menuButton.addEventListener("click", () => {
  const open = menu.classList.toggle("show");
  menuButton.setAttribute("aria-expanded", String(open));
  menuButton.textContent = open ? "×" : "☰";
});

menu.querySelectorAll("a").forEach(link => {
  link.addEventListener("click", () => {
    menu.classList.remove("show");
    menuButton.setAttribute("aria-expanded", "false");
    menuButton.textContent = "☰";
  });
});

const secret = $("secret");
const input = $("terminalInput");
const output = $("output");
let typed = "";

function openTerminal() {
  secret.classList.add("open");
  secret.setAttribute("aria-hidden", "false");
  input.value = "";
  setTimeout(() => input.focus(), 50);
}

function closeTerminal() {
  secret.classList.remove("open");
  secret.setAttribute("aria-hidden", "true");
}

document.addEventListener("keydown", event => {
  if (event.key === "Escape") closeTerminal();

  if (
    event.ctrlKey || event.altKey || event.metaKey ||
    event.key.length !== 1 ||
    event.target instanceof HTMLInputElement ||
    event.target instanceof HTMLTextAreaElement
  ) return;

  typed = (typed + event.key.toLowerCase()).slice(-6);
  if (typed === "rokros") {
    openTerminal();
    typed = "";
  }
});

$("closeTerminal").addEventListener("click", closeTerminal);

secret.addEventListener("click", event => {
  if (event.target === secret) closeTerminal();
});

function line(text, className = "") {
  const p = document.createElement("p");
  p.textContent = text;
  if (className) p.className = className;
  output.appendChild(p);
  output.scrollTop = output.scrollHeight;
}

const commands = {
  help() {
    line("Available commands:", "success");
    line("help      - Show available commands");
    line("about     - About RokrOS");
    line("neofetch  - Show project information");
    line("date      - Display local date and time");
    line("clear     - Clear terminal output");
    line("exit      - Close terminal");
  },

  about() {
    line("RokrOS is an experimental technology project.");
    line("Created by DaryTech. Built around curiosity.");
    line("This is a simulated web terminal, not a real OS shell.");
  },

  neofetch() {
    line("       ____       _     ____   ____", "success");
    line("      |  _ \\ ___ | | __|  _ \\ / ___|", "success");
    line("      | |_) / _ \\| |/ /| |_) | |", "success");
    line("      |  _ < (_) |   < |  _ <| |___", "success");
    line("      |_| \\_\\___/|_|\\_\\|_| \\_\\\\____|", "success");
    line("");
    line("OS: RokrOS project website");
    line("Creator: DaryTech");
    line("Shell: Rokr Web Shell");
    line("Status: Exploring");
  },

  date() {
    line(new Date().toLocaleString());
  },

  clear() {
    output.replaceChildren();
  },

  exit() {
    closeTerminal();
  }
};

$("terminalForm").addEventListener("submit", event => {
  event.preventDefault();
  const raw = input.value.trim();
  if (!raw) return;

  line("visitor@rokros:~$ " + raw);

  const command = raw.toLowerCase();
  if (Object.prototype.hasOwnProperty.call(commands, command)) {
    commands[command]();
  } else {
    line('Command not found: ' + raw + '. Type "help" for commands.', "error");
  }

  input.value = "";
});
</script>
